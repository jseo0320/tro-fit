OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
LTX_API_KEY=
# Choose ltx-2-3-fast or ltx-2-3-pro. 2B Distilled is not an API model.
LTX_MODEL=ltx-2-3-fast
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tro_fit_db
# Optional override; otherwise DATABASE_URL is used.
# RAG_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/tro_fit_db
